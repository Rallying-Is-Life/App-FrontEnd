@model List<App_FrontEnd.Models.ClubItem>
<div class="container">
<h2>Clubs</h2>
<p class="text-muted">Alphabetical, paginated from API (20/page).</p>
@if (Model == null || Model.Count == 0)
{
    <p>No clubs found in DB (two expected).</p>
}
else
{
    <table class="table table-striped"><thead><tr><th>Club</th><th>Logo URL</th></tr></thead><tbody>
    @foreach (var c in Model)
    {
        <tr><td>@c.ClubName</td><td>@(string.IsNullOrEmpty(c.LogoUrl) ? "—" : $"<img src=\"{c.LogoUrl}\" height=\"40\" />")</td></tr>
    }
    </tbody></table>
}
</div>
