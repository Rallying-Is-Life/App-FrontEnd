@page
@model IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Home page";
}
<div class="text-center">
    <h1 class="display-4">Rallying Is Life</h1>
    <p>Rallying Is Life — a new, free platform for rally results (with live results to come), driver and car profiles, club profiles and all things rallying. Built on crowd-sourced data, the stats and information will grow immense. And best of all — no adverts.</p>
    <div class="row justify-content-center flex-wrap" id="stats-row">
        <div class="col-6 col-md-2"><a asp-page="/Clubs" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">🏁</span><h5 class="card-title mt-2">Clubs</h5><p class="card-text fs-4" id="clubs-count">--</p></div></div></a></div>
        <div class="col-6 col-md-2"><a asp-page="/Rallies" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">🏆</span><h5 class="card-title mt-2">Rallies</h5><p class="card-text fs-4" id="rallies-count">--</p></div></div></a></div>
    </div>
    <div class="row justify-content-center mt-3 flex-wrap" id="cars-row">
        <div class="col-6 col-md-2"><a asp-page="/Cars" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">🚗</span><h5 class="card-title mt-2">Cars</h5><p class="card-text fs-4" id="cars-count">--</p></div></div></a></div>
        <div class="col-6 col-md-2"><a asp-page="/Drivers" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">👤</span><h5 class="card-title mt-2">Drivers</h5><p class="card-text fs-4" id="drivers-count">--</p></div></div></a></div>
        <div class="col-6 col-md-2"><a asp-page="/CoDrivers" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">👥</span><h5 class="card-title mt-2">Co-Drivers</h5><p class="card-text fs-4" id="coDrivers-count">--</p></div></div></a></div>
    </div>
    <div class="row justify-content-center mt-3 flex-wrap" id="rescue-recovery-row">
        <div class="col-6 col-md-2"><a asp-page="/RescueUnits" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">🚑</span><h5 class="card-title mt-2">Rescue Units</h5><p class="card-text fs-4" id="rescue-units-count">--</p></div></div></a></div>
        <div class="col-6 col-md-2"><a asp-page="/RecoveryUnits" class="text-decoration-none"><div class="card text-center shadow-sm hover-lift h-100"><div class="card-body"><span class="fs-2">🔧</span><h5 class="card-title mt-2">Recovery Units</h5><p class="card-text fs-4" id="recovery-units-count">--</p></div></div></a></div>
    </div>
    <script>fetch('@(Configuration["apiRallyingIsLifeBaseURL"] ?? "/stats")/stats').then(r=>r.json()).then(d=>{document.getElementById('clubs-count').textContent=d.clubs;document.getElementById('rallies-count').textContent=d.rallies;document.getElementById('cars-count').textContent=d.cars;document.getElementById('drivers-count').textContent=d.drivers;document.getElementById('rescue-units-count').textContent=d.rescueUnits;document.getElementById('recovery-units-count').textContent=d.recoveryUnits;document.getElementById('coDrivers-count').textContent=d.coDrivers;}).catch(_=>{});</script>
    <style>.hover-lift{transition:transform .15s ease, box-shadow .15s ease;}.hover-lift:hover{transform:translateY(-3px);box-shadow:0 .5rem 1rem rgba(0,0,0,.15);}</style>
</div>
