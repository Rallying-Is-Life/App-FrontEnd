@page
@model App_FrontEnd.Pages.CrewDetail
@{
    ViewData["Title"] = "Crew Detail";
}
<div class="card-modern p-4 mb-4">
    @if (!string.IsNullOrEmpty(Model.RallyName))
    {
        <h2>@Model.EventDate.Year @Model.RallyName</h2>
        <p class="text-muted">Crew Stage Times Detail</p>
    }
    else
    {
        <h2>Crew Detail</h2>
        <p class="text-muted">Stage Times Detail</p>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h4>
                        @if (!string.IsNullOrEmpty(Model.DriverCountry))
                        {
                            <img src="@Model.GetFlagUrl(Model.DriverCountry)" class="flag-icon me-2" style="width:24px;height:16px;" alt="@Model.DriverCountry" />
                        }
                        @Model.DriverName
                        @if (!string.IsNullOrEmpty(Model.CoDriverName))
                        {
                            <text> / </text>
                            @if (!string.IsNullOrEmpty(Model.CoDriverCountry))
                            {
                                <img src="@Model.GetFlagUrl(Model.CoDriverCountry)" class="flag-icon me-2" style="width:20px;height:14px;" alt="@Model.CoDriverCountry" />
                            }
                            @Model.CoDriverName
                        }
                    </h4>
                    <p class="text-muted mb-1">Car #: <strong>@Model.RaceNumber</strong></p>
                    <p class="text-muted mb-1">Class: <strong>@Model.RaceClass</strong></p>
                    @if (Model.OverallPosition.HasValue)
                    {
                        <p class="text-muted mb-1">Overall: <strong>@Model.OverallPosition@Model.GetTrophyEmoji(Model.OverallPosition)</strong></p>
                    }
                    @if (Model.ClassPosition.HasValue)
                    {
                        <p class="text-muted mb-1">Class: <strong>@Model.ClassPosition@Model.GetTrophyEmoji(Model.ClassPosition)</strong></p>
                    }
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-1">Status: <span class="badge @Model.GetStatusBadgeClass(Model.Status)">@Model.Status</span></p>
                    <p class="mb-1">Total Time: <strong>@Model.FormatTime(Model.TotalTimeSeconds)</strong></p>
                    <p class="mb-1">Stages Completed: <strong>@Model.StagesCompleted / @Model.TotalStages</strong></p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-secondary mt-2" href="/Leaderboard?id=@Model.RallyRowKey">← Back to Leaderboard</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover table-bordered rounded table-container">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width:60px;">Stage</th>
                    <th style="width:200px;">Stage Name</th>
                    <th class="text-center" style="width:100px;">Type</th>
                    <th class="text-center" style="width:120px;">Time</th>
                    <th class="text-center" style="width:100px;">Status</th>
                    <th class="text-center" style="width:100px;">Bogey</th>
                    <th class="text-center" style="width:100px;">Max Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Stages)
                {
                    var rowClass = "";
                    if (s.BogeyTimeHit == true || s.MaxTimeHit == true)
                    {
                        rowClass = "table-danger";
                    }
                    <tr class="@rowClass hover-lift">
                        <td class="text-center fw-bold">SS@(s.StageSequence)</td>
                        <td>@s.StageName</td>
                        <td class="text-center">@s.StageType</td>
                        <td class="text-center">@Model.FormatStageTime(s.TimeSeconds)</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(s.Status))
                            {
                                <span class="badge @Model.GetStatusBadgeClass(s.Status)">@s.Status</span>
                            }
                            @if (!string.IsNullOrEmpty(s.RetirementReason))
                            {
                                <br /><small class="text-muted">@s.RetirementReason</small>
                            }
                        </td>
                        <td class="text-center">
                            @if (s.BogeyTimeSeconds.HasValue)
                            {
                                <small>@Model.FormatStageTime(s.BogeyTimeSeconds)</small>
                            }
                            @if (s.BogeyTimeHit == true)
                            {
                                <span class="badge bg-warning text-dark">Bogey Hit</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (s.MaxTimeSeconds.HasValue)
                            {
                                <small>@Model.FormatStageTime(s.MaxTimeSeconds)</small>
                            }
                            @if (s.MaxTimeHit == true)
                            {
                                <span class="badge bg-danger">Max Time Hit</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Stages.Count == 0)
    {
        <p class="text-muted">No stage times found for this entrant.</p>
    }
</div>
<style>
.hover-lift { transition: transform .15s ease, box-shadow .15s ease; }
.hover-lift:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15); }
</style>