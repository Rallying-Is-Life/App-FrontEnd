@page
@model App_FrontEnd.Pages.DriversModel
@{
    ViewData["Title"] = "Drivers";
}
<div class="card-modern p-4 mb-4">
<h2>Drivers</h2>
<p class="text-muted">Directory of drivers.</p>
<div class="table-responsive">
<table class="table table-sm table-striped table-hover table-bordered rounded table-container"><thead><tr><th>First Name</th><th>Surname</th><th>Nationality</th></tr></thead>
<tbody>
@foreach (var p in Model.People.OrderBy(x => x.surname))
{
<tr><td>@p.firstName</td><td>@p.surname</td><td>@p.flag</td></tr>
}
</tbody>
</table>
</div>
</div>
