@page
@model App_FrontEnd.Pages.DriversModel
@{
    ViewData["Title"] = "Drivers";
}
<div class="card-modern p-4 mb-4">
<h2>Driver Directory</h2>
<p class="text-muted">Ordered by name. Search via query.</p>
<div class="table-responsive">
<table class="table table-sm table-striped table-hover table-bordered rounded">
<thead class="table-light"><tr><th>First Name</th><th>Surname</th><th>Nationality</th><th>Event</th><th>Year</th></tr></thead>
<tbody>
@foreach (var p in Model.People)
{
<tr><td>@p.firstName</td><td>@p.surname</td><td>@p.nationality</td><td>@p.eventName</td><td>@p.eventYear</td></tr>
}
</tbody>
</table>
</div>
</div>
