@page
@model App_FrontEnd.Pages.RallyProfile
@{
    string FormatDateRange()
    {
        if (Model.EndDate.HasValue && Model.EndDate.Value != Model.EventDate)
        {
            return Model.EventDate.ToString("dd/MM/yyyy") + "-" + Model.EndDate.Value.ToString("dd/MM/yyyy");
        }
        return Model.EventDate.ToString("dd/MM/yyyy");
    }
    string DateDisplay = FormatDateRange();
    bool IsMultiDay = Model.EndDate.HasValue && Model.EndDate.Value != Model.EventDate;
}
@{
    ViewData["Title"] = "Rally Profile";
}
<div class="card-modern p-4 mb-4">
    @if (!string.IsNullOrEmpty(Model.LogoUrl) && !string.IsNullOrEmpty(Model.RallyName) && Model.EventDate != null)
    {
        <div class="text-center mb-3">
            <img src="@Model.LogoUrl" alt="Rally logo" style="max-width:150px;max-height:150px;object-fit:contain;" />
            <h2>@Model.EventDate.Year @Model.RallyName</h2>
        </div>
    }
    else
    {
        <h2>Rally Profile</h2>
    }
    <p class="text-muted">Overview of this rally</p>
    
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <p class="card-text"><a href="@(Model.Website.StartsWith("@url:") ? Model.Website.Substring(5).Trim('`') : Model.Website)" target="_blank">@(Model.Website.StartsWith("@url:") ? Model.Website.Substring(5).Trim('`') : Model.Website)</a></p>
                    }
                    <p class="card-text">
                        <strong>Date:</strong> @DateDisplay
                    </p>
                    <p class="card-text">
                        <strong>Length:</strong> @Model.LengthKm km
                    </p>
                    <p class="card-text">
                        <strong>Stages:</strong> @Model.StageCount
                    </p>
                    <p class="card-text">
                        <strong>Entries:</strong> @Model.EntryCount
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Country))
                    {
                        <p class="card-text"><strong>Country:</strong> <span><img src="@Model.FlagUrl" alt="Flag" style="height:20px; width:auto; margin-left:8px;" /></span></p>
                    }
                    @if (Model.EntryCount > 0)
                    {
                        <div class="d-flex gap-2 flex-wrap mt-2">
                            <a class="btn btn-sm btn-outline-primary" href="/EntryListSeeded?id=@Model.RallyRowKey">Entry List (Seeded)</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/EntryListUnseeded?id=@Model.RallyRowKey">Entry List (Unseeded)</a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Flag</th>
                                <th>Leg</th>
                                @if (IsMultiDay)
                                {
                                    <th>Date</th>
                                }
                                <th>Stage Name</th>
                                <th>Length</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stage in Model.Stages)
                            {
                                <tr>
                                    <td>@stage.StageNumber</td>
                                    <td>@if (!string.IsNullOrEmpty(stage.FlagUrl)) { <img src="@stage.FlagUrl" alt="Flag" style="height:20px; width:auto;" /> }</td>
                                    <td>@stage.Leg</td>
                                    @if (IsMultiDay)
                                    {
                                        <td>@(stage.StageDate.HasValue ? stage.StageDate.Value.ToString("dd/MM/yyyy") : string.Empty)</td>
                                    }
                                    <td>@stage.StageName</td>
                                    <td>@stage.StageLength</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>