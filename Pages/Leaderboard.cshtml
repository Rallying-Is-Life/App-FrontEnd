@page
@model App_FrontEnd.Pages.Leaderboard
@{
    ViewData["Title"] = "Leaderboard";
    var hasClassFilter = !string.IsNullOrEmpty(Model.ClassId);
}
<div class="card-modern p-4 mb-4">
    @if (!string.IsNullOrEmpty(Model.RallyName))
    {
        <h2>@Model.EventDate.Year @Model.RallyName</h2>
        <p class="text-muted">Full Results @(hasClassFilter ? $"— Class: {Model.ClassId}" : "— Overall")</p>
    }
    else
    {
        <h2>Leaderboard</h2>
        <p class="text-muted">Full Results @(hasClassFilter ? $"— Class: {Model.ClassId}" : "— Overall")</p>
    }

    @* Class filter tabs *@
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(!hasClassFilter ? "active" : "")" href="/Leaderboard?id=@Model.RallyRowKey" role="tab">Overall</a>
        </li>
        @if (Model.Entries.Any())
        {
            var classes = Model.Entries.Where(e => !string.IsNullOrEmpty(e.RaceClass)).Select(e => e.RaceClass).Distinct().OrderBy(c => c);
            foreach (var cls in classes)
            {
                var isActive = string.Equals(cls, Model.ClassId, StringComparison.OrdinalIgnoreCase);
                <li class="nav-item" role="presentation">
                    <a class="nav-link @(isActive ? "active" : "")" href="/Leaderboard?id=@Model.RallyRowKey&classId=@cls" role="tab">Class @cls</a>
                </li>
            }
        }
    </ul>

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover table-bordered rounded table-container">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width:60px;">Pos</th>
                    <th class="text-center" style="width:60px;">Class Pos</th>
                    <th class="text-center" style="width:80px;">Car #</th>
                    <th>Driver</th>
                    <th>Co-Driver</th>
                    <th>Class</th>
                    <th>Car</th>
                    <th class="text-end" style="width:120px;">Time</th>
                    <th class="text-center" style="width:100px;">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries)
                {
                    var isFinished = string.Equals(e.Status, "Finished", StringComparison.OrdinalIgnoreCase);
                    var rowClass = isFinished ? "" : "table-warning";
                    <tr class="@rowClass hover-lift">
                        <td class="text-center fw-bold">@(e.OverallPosition.HasValue ? e.OverallPosition.Value.ToString() : "—")</td>
                        <td class="text-center">@(e.ClassPosition.HasValue ? e.ClassPosition.Value.ToString() : "—")</td>
                        <td class="text-center fw-bold">@e.RaceNumber</td>
                        <td>
                            <a class="text-decoration-none" href="/CrewDetail?rallyRowKey=@Model.RallyRowKey&entrantId=@e.EntrantId">@e.DriverName</a>
                        </td>
                        <td>@e.CoDriverName</td>
                        <td class="text-center">@e.RaceClass</td>
                        <td>
                            @if (!string.IsNullOrEmpty(e.CarMake) || !string.IsNullOrEmpty(e.CarModel))
                            {
                                <strong>@e.CarMake @e.CarModel</strong>
                            }
                        </td>
                        <td class="text-end">@Model.FormatTime(e.TotalTimeSeconds)</td>
                        <td class="text-center">
                            @if (isFinished)
                            {
                                <span class="badge bg-success">Finished</span>
                            }
                            else if (string.Equals(e.Status, "Retired", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">Retired</span>
                            }
                            else if (string.Equals(e.Status, "Running", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary">Running</span>
                            }
                            else if (string.Equals(e.Status, "SuperRally", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-info text-dark">SuperRally</span>
                            }
                            else if (string.Equals(e.Status, "Excluded", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-dark">Excluded</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@e.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Entries.Count == 0)
    {
        <p class="text-muted">No results found for this rally.</p>
    }
    <p class="text-muted small mt-2">Total entries: @Model.TotalCount</p>
</div>
<link rel="stylesheet" href="~/css/reg-plate.css" />
<style>
.hover-lift { transition: transform .15s ease, box-shadow .15s ease; }
.hover-lift:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15); }
</style>