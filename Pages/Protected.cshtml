@page
@model RallyingIsLife.Pages.ProtectedModel
@{
    ViewData["Title"] = "Auth Demo";
}
<div class="text-center">
    <h2>Auth Demo — Protected</h2>
    <p>Hello, <strong>@User.Identity?.Name</strong></p>
    <p>Tenant: <code>@Model.TenantId</code></p>
    <hr />
    <p>OBO call to /stats:</p>
    <pre>@Model.ApiResult</pre>
</div>
