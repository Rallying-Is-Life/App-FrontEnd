@page
@model App_FrontEnd.Pages.PersonProfile
@using App_FrontEnd.Pages
@{
    ViewData["Title"] = "Person Profile";
}
<div class="card-modern p-4 mb-4">
    <h2>Person Profile</h2>
    <div class="row align-items-center g-3 mb-3">
        <div class="col">
            <h3 class="mb-1">@Model.FirstName @Model.Surname</h3>
            <p class="card-text mb-0">
                Nationality: @Model.Nationality
                @if (!string.IsNullOrEmpty(Model.FlagUrl))
                {
                    <img src="@Model.FlagUrl" alt="Flag" style="height:20px; width:auto; margin-left:8px;" />
                }
            </p>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>Events</h5>
                    @if (Model.Events.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Year</th>
                                        <th>Rally</th>
                                        <th>Role</th>
                                        <th>Partner</th>
                                        <th>Car</th>
                                        <th>VRM</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Overall</th>
                                        <th class="text-center">Class</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in Model.Events)
                                    {
                                        var logoKey = string.IsNullOrEmpty(e.carMake) ? "" : PersonProfile.LogoKey(e.carMake);
                                        var storageAccount = Environment.GetEnvironmentVariable("StorageAccountName") ?? "rallyingislife";
                                        var logoUrl = $"https://{storageAccount}.blob.core.windows.net/mfrlogo/{logoKey}.png";
                                        <tr>
                                            <td>@e.year</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(e.rallyRowKey))
                                                {
                                                    <a class="text-decoration-none" href="/RallyProfile?id=@e.rallyRowKey">@e.rallyName</a>
                                                }
                                                else
                                                {
                                                    <span>@e.rallyName</span>
                                                }
                                            </td>
                                            <td>@e.role</td>
                                            <td>@(string.IsNullOrEmpty(e.partnerName) ? "—" : e.partnerName)</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(e.carMake))
                                                {
                                                    <img src="@logoUrl" alt="@e.carMake" style="height:22px; width:auto; object-fit:contain; vertical-align:middle; margin-right:6px;" onerror="this.style.display='none'" />
                                                    <strong>@e.carMake @e.carModel</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrEmpty(e.carVrm) ? "—" : e.carVrm)</td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(e.status))
                                                {
                                                    var badgeClass = e.status.ToLowerInvariant() switch {
                                                        "finished" => "bg-success",
                                                        "retired" => "bg-danger",
                                                        "running" => "bg-primary",
                                                        "superrally" => "bg-info text-dark",
                                                        "excluded" => "bg-dark",
                                                        _ => "bg-secondary"
                                                    };
                                                    <span class="badge @badgeClass">@e.status</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-center">@(e.overallPosition.HasValue ? e.overallPosition.Value.ToString() : "—")</td>
                                            <td class="text-center">@(e.classPosition.HasValue ? e.classPosition.Value.ToString() : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No events found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>