@page
@model App_FrontEnd.Pages.CoDriversModel
@{
    ViewData["Title"] = "Co-Drivers";
}
<div class="card-modern p-4 mb-4">
<h2>Co-Drivers</h2>
<p class="text-muted">Directory of co-drivers.</p>
<div class="table-responsive">
<table class="table table-sm table-striped table-hover table-bordered rounded table-container">
<thead><tr><th>Name</th><th>Nationality</th></tr></thead>
<tbody>
@foreach (var p in Model.People.OrderBy(x => x.surname))
{
<tr><td>@p.firstName @p.surname</td><td>@p.flag</td></tr>
}
</tbody>
</table>
</div>
</div>