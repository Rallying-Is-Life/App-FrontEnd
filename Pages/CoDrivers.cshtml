@page
@model App_FrontEnd.Pages.CoDriversModel
@{
    ViewData["Title"] = "Co-Drivers";
}
<div class="card-modern p-4 mb-4">
<h2>Co-Drivers</h2>
<p class="text-muted">Directory of co-drivers.</p>
<div class="table-responsive">
<table class="table table-sm table-striped table-hover table-bordered rounded">
<thead class="table-light"><tr><th>First Name</th><th>Surname</th><th>Nationality</th></tr></thead>
<tbody>
@foreach (var p in Model.People.OrderBy(x => x.surname))
{
<tr><td>@p.firstName</td><td>@p.surname</td><td>@p.nationality</td></tr>
}
</tbody>
</table>
</div>
<h3>Events (newest first)</h3>
<ul>
@foreach (var p in Model.People.OrderByDescending(x => (x.eventYear ?? "")))
{
<li>@p.eventName (@p.eventYear) — @p.surname, @p.firstName</li>
}
</ul>
</div>
