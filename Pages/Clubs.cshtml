@page
@model App_FrontEnd.Pages.ClubsModel
@{
    ViewData["Title"] = "Clubs";
}
<div class="card-modern p-4 mb-4">
<h2>Club List</h2>
<p class="text-muted">Directory of motor clubs that have held rallies.</p>
<div class="table-responsive">
    <table class="table table-sm table-striped table-hover table-bordered rounded table-container">
<thead class="table-light"><tr><th>Club Name</th></tr></thead>
<tbody>
        @foreach (var c in Model.Clubs)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(c.LogoUrl))
                        {
                            <img loading="lazy" src="@c.LogoUrl" alt="" style="width:32px;height:32px;object-fit:contain;" />
                        }
                        else
                        {
                            <span style="display:inline-block;width:32px;height:32px;" aria-label="no logo"></span>
                        }
                        <a class="text-decoration-none" href="/ClubProfile?id=@c.RowKey">@c.ClubName</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
</div>
