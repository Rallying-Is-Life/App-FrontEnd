@page
@model RallyingIsLife.Pages.RalliesModel
@{
    ViewData["Title"] = "Rallies";
}
<h2>Rallies</h2>
<table class="table"><thead><tr><th>Year</th><th>Name</th><th>Competitive Distance</th></tr></thead>
<tbody>
@foreach (var r in Model.Rallies)
{
<tr><td>@r.Year</td><td>@r.EventName</td><td>@(r.CompetitiveDistanceKm.ToString("0.0")) @r.DistanceUnit</td></tr>
}
</tbody></table>
<div class="mt-3">
@if (Model.Page > 1) { <a class="btn btn-sm btn-outline-primary" href="/Rallies?page=@(Model.Page - 1)">← Previous</a> }
<span class="mx-2">Page @Model.Page</span>
<a class="btn btn-sm btn-outline-primary" href="/Rallies?page=@(Model.Page + 1)">Next →</a>
</div>
