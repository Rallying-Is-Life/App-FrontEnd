@page
@model App_FrontEnd.Pages.StageClassification
@{
    ViewData["Title"] = "Stage Classification";
    var hasStageSelected = Model.SelectedStageSeq.HasValue;
    var hasClassFilter = !string.IsNullOrEmpty(Model.ClassId);
    
    // Build stage options to avoid RZ1031
    var stageOptions = new System.Text.StringBuilder();
    stageOptions.Append("<option value=\"\">— Select Stage —</option>");
    foreach (var s in Model.StageList)
    {
        var selected = Model.SelectedStageSeq.HasValue && Model.SelectedStageSeq.Value == s.StageNumber ? " selected" : "";
        stageOptions.Append($"<option value=\"{s.StageNumber}\"{selected}>SS{s.StageNumber} - {s.StageName}</option>");
    }
    
    // Build class filter options
    var classOptions = new System.Text.StringBuilder();
    if (hasStageSelected && Model.Entries.Any())
    {
        classOptions.Append("<option value=\"\">All Classes (Overall)</option>");
        var classes = Model.Entries.Where(e => !string.IsNullOrEmpty(e.RaceClass)).Select(e => e.RaceClass).Distinct().OrderBy(c => c);
        foreach (var cls in classes)
        {
            var selected = string.Equals(cls, Model.ClassId, StringComparison.OrdinalIgnoreCase) ? " selected" : "";
            classOptions.Append($"<option value=\"{cls}\"{selected}>Class {cls}</option>");
        }
    }
}
<div class="card-modern p-4 mb-4">
    @if (!string.IsNullOrEmpty(Model.RallyName))
    {
        <h2>@Model.EventDate.Year @Model.RallyName</h2>
        <p class="text-muted">Stage Classification @(hasStageSelected ? $"— SS{Model.SelectedStageSeq}: {Model.SelectedStageName}" : "") @(hasClassFilter ? $"— Class: {Model.ClassId}" : "")</p>
    }
    else
    {
        <h2>Stage Classification</h2>
        <p class="text-muted">Select a stage to view classification @(hasClassFilter ? $"— Class: {Model.ClassId}" : "")</p>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <label class="form-label">Select Stage</label>
            <select class="form-select" id="stageSelector" onchange="window.location.href = '/StageClassification?id=@Model.RallyRowKey&stageSeq=' + this.value + '@(hasClassFilter ? "&classId=" + Model.ClassId : "")'">
                @Html.Raw(stageOptions.ToString())
            </select>
        </div>
        @if (hasStageSelected && Model.Entries.Any())
        {
            <div class="col-md-6 d-flex align-items-end">
                <div class="w-100">
                    <label class="form-label">Filter by Class</label>
                    <select class="form-select" id="classFilter" onchange="window.location.href = '/StageClassification?id=@Model.RallyRowKey&stageSeq=@Model.SelectedStageSeq&classId=' + this.value">
                        @Html.Raw(classOptions.ToString())
                    </select>
                </div>
            </div>
        }
    </div>

    @if (hasStageSelected)
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover table-bordered rounded table-container">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width:60px;">Pos</th>
                        <th class="text-center" style="width:80px;">Car #</th>
                        <th>Driver</th>
                        <th>Co-Driver</th>
                        <th class="text-center" style="width:80px;">Class</th>
                        <th class="text-center" style="width:120px;">Time</th>
                        <th class="text-center" style="width:100px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        <tr class="hover-lift">
                            <td class="text-center fw-bold">@e.Position</td>
                            <td class="text-center fw-bold">@e.RaceNumber</td>
                            <td>@e.DriverName</td>
                            <td>@e.CoDriverName</td>
                            <td class="text-center">@e.RaceClass</td>
                            <td class="text-center">@Model.FormatTime(e.TimeSeconds)</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(e.Status))
                                {
                                    <span class="badge @(e.Status.ToLowerInvariant() switch {
                                        "finished" => "bg-success",
                                        "retired" => "bg-danger",
                                        "running" => "bg-primary",
                                        "superrally" => "bg-info text-dark",
                                        "excluded" => "bg-dark",
                                        "dns" => "bg-secondary",
                                        "dnf" => "bg-danger",
                                        "dsq" => "bg-dark",
                                        _ => "bg-secondary"
                                    })">@e.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Entries.Count == 0)
        {
            <p class="text-muted">No classification data for this stage.</p>
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <p>Select a stage from the dropdown above to view the classification.</p>
        </div>
    }
</div>
<style>
.hover-lift { transition: transform .15s ease, box-shadow .15s ease; }
.hover-lift:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15); }
</style>