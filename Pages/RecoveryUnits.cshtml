@page
@model App_FrontEnd.Pages.RecoveryUnitsModel
@{ ViewData["Title"] = "Recovery Units"; }
<div class="card-modern p-4 mb-4"><h2>Recovery Units</h2>
<p class="text-muted">Directory of recovery units.</p>
<table class="table table-striped"><thead><tr><th>Unit</th></tr></thead>
<tbody>
@foreach (var u in Model.Units) { <tr><td>@(u.Name ?? u.RowKey)</td></tr> }
</tbody></table>
</div>
