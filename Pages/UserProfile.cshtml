@page
@model App_FrontEnd.Pages.UserProfile
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="FirstName" class="form-label">First Name</label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Surname" class="form-label">Surname</label>
        <input asp-for="Surname" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="Country" class="form-label">Nationality</label>
        <select asp-for="Country" asp-items="Model.Countries" class="form-select" id="countrySelect">
            <option value="">Select country...</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="Region" class="form-label">Region (UK only)</label>
        <select asp-for="Region" asp-items="Model.Regions" class="form-select" id="regionSelect">
            <option value="">Select region...</option>
        </select>
    </div>

    <div class="col-12">
        <div class="form-check">
            @{
                var regionDisabled = Model.Country != "GB" ? "disabled" : "";
            }
            <input class="form-check-input" type="checkbox" id="showRegion" @regionDisabled />
            <label class="form-check-label" for="showRegion">Show UK regions</label>
        </div>
    </div>

    <div class="col-12">
        @if (!string.IsNullOrEmpty(Model.FlagUrl))
        {
            <img src="@Model.FlagUrl" alt="Flag" style="height: 48px; width: auto;" />
        }
        else
        {
            <span class="text-muted">No flag (select country to see flag)</span>
        }
    </div>

    <hr />

    <div class="col-12">
        <h5>Read-only Information</h5>
        <dl class="row">
            <dt class="col-sm-3">Entra OID</dt>
            <dd class="col-sm-9"><code>@Model.EntraOid</code></dd>
            <dt class="col-sm-3">Person RowKey</dt>
            <dd class="col-sm-9"><code>@Model.PersonRowKey</code></dd>
            <dt class="col-sm-3">Competitor License</dt>
            <dd class="col-sm-9">@Model.CompetitorLicense</dd>
            <dt class="col-sm-3">Marshal License</dt>
            <dd class="col-sm-9">@Model.MarshalLicense</dd>
        </dl>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save Profile</button>
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const countrySelect = document.getElementById('countrySelect');
            const regionSelect = document.getElementById('regionSelect');
            const showRegionCheckbox = document.getElementById('showRegion');

            function updateRegionVisibility() {
                const isGB = countrySelect.value === 'GB';
                regionSelect.disabled = !isGB;
                showRegionCheckbox.disabled = !isGB;
                showRegionCheckbox.checked = isGB;
            }

            countrySelect.addEventListener('change', updateRegionVisibility);
            updateRegionVisibility();
        });
    </script>
}