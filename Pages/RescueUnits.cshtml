@page
@model App_FrontEnd.Pages.RescueUnitsModel
@{ ViewData["Title"] = "Rescue Units"; }
<div class="card-modern p-4 mb-4"><h2>Rescue Units</h2>
<p class="text-muted">Directory of rescue units.</p>
<table class="table table-striped"><thead><tr><th>Unit</th></tr></thead>
<tbody>
@foreach (var u in Model.Units) { <tr><td><a class="text-decoration-none" href="/profile/rescueunit?id=@u.RowKey">@(u.Name ?? u.RowKey)</a></td></tr> }
</tbody></table>
</div>
