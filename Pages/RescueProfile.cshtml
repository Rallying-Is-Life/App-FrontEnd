@page
@model App_FrontEnd.Pages.RescueProfile
@{
    ViewData["Title"] = "Rescue Unit Profile";
}
<div class="card-modern p-4 mb-4">
    <h2>Rescue Unit Profile</h2>
    <h3>@Model.Name</h3>
    <div class="row g-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>Events</h5>
                    <table class="table table-striped table-hover align-middle"><thead class="table-dark"><tr><th>Year</th><th>Event</th><th>Stage</th><th>Stage Name</th><th>Position</th></tr></thead><tbody>
                    @foreach(var e in Model.Events) { <tr><td>@e.year</td><td>@e.eventName</td><td>@e.stageNumber</td><td>@e.stageName</td><td>@e.pointType</td></tr> }
                    </tbody></table>
                </div>
            </div>
        </div>
    </div>
</div>
