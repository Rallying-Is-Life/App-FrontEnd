@page
@model App_FrontEnd.Pages.CarsModel
@{
ViewData["Title"] = "Cars";
}
<div class="card-modern p-4 mb-4">
<h2>Car List</h2>
<p class="text-muted">Directory of cars that have competed.</p>
<form method="get" action="/Cars" class="mb-3"><input type="text" name="q" value="@Request.Query["q"]" placeholder="Search car (Make / Model / VRM)" class="form-control" /></form>
<div class="table-responsive">
<table class="table table-sm table-striped table-hover table-bordered rounded table-container">
<thead><tr><th>Car</th></tr></thead>
<tbody>
@foreach (var c in Model.Cars) {
<tr><td><a class="text-decoration-none" href="/CarProfile?id=@c.RowKey">@c.Make @c.Model (@c.VRM)</a></td></tr>
}
</tbody></table>
<div class="mt-2">
@if (Model.Page > 1) { <a class="btn btn-sm btn-outline-primary" href="/Cars?p=@(Model.Page - 1)">Previous</a> }
<a class="btn btn-sm btn-outline-secondary" href="/Cars?p=@(Model.Page + 1)">Next</a>
</div>
<!-- cars-fix-page-116 -->
</div>
</div>
