<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Rallying Is Life</title>
<script type="importmap"></script>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/RallyingIsLife.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Rallying Is Life</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Home</a></li>
                        <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Directories</a>
                        <ul class="dropdown-menu"><li><a class="dropdown-item" asp-area="" asp-page="/Cars">Cars</a></li><li><a class="dropdown-item" asp-area="" asp-page="/Clubs">Clubs</a>
                        <li><a class="dropdown-item" asp-area="" asp-page="/Drivers">Drivers</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-page="/CoDrivers">Co-Drivers</a></li></li><li><a class="dropdown-item" asp-area="" asp-page="/Rallies">Rallies</a></li><li><a class="dropdown-item" asp-area="" asp-page="/RecoveryUnits">Recovery Units</a></li><li><a class="dropdown-item" asp-area="" asp-page="/RescueUnits">Rescue Units</a></li></ul></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Privacy">Privacy</a></li>
                        @if (User.Identity?.IsAuthenticated == true) { <li class="nav-item"><span class="nav-link">Hello @User.Identity?.Name</span></li><li class="nav-item"><form action="/logout" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="nav-link btn btn-link">Sign out</button></form></li> }
                        else { <li class="nav-item"><a class="nav-link" href="/login">Sign in</a></li> }
                    </ul>
                </div>
                <button onclick="toggleTheme()" class="btn btn-sm btn-outline-secondary">Light/Dark</button>
            </div>
        </nav>
    </header>
    <div class="container"><main role="main" class="pb-3">@RenderBody()</main></div>
    <footer class="border-top footer text-muted"><div class="container">&copy; @DateTime.Now.Year - Rallying Is Life - <a asp-area="" asp-page="/Clubs">Clubs</a> | <a asp-area="" asp-page="/Rallies">Rallies</a> | <a asp-area="" asp-page="/Cars">Cars</a> | <a asp-area="" asp-page="/Drivers">Drivers</a> | <a asp-area="" asp-page="/CoDrivers">Co-Drivers</a> | <a asp-area="" asp-page="/RescueUnits">Rescue Units</a> | <a asp-area="" asp-page="/RecoveryUnits">Recovery Units</a> | <a asp-area="" asp-page="/Privacy">Privacy</a></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
