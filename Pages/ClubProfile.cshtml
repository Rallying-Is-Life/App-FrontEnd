@page
@model App_FrontEnd.Pages.ClubProfile
@{
    ViewData["Title"] = "Club Profile";
}
<div class="card-modern p-4 mb-4">
    <h2>Club Profile</h2>
    <div class="row align-items-center g-3 mb-3">
        <div class="col-auto"><img src="@Model.LogoUrl" alt="Club logo" style="max-width:120px;max-height:120px;object-fit:contain;" /></div>
        <div class="col"><h3 class="mb-1">@Model.ClubName</h3><p class="text-muted mb-0">Overview of this club</p><p class="card-text mb-0"><strong>Website:</strong> <a href="@Model.Website">@Model.Website</a></p></div>
    </div>
    <div class="row g-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>Rallies</h5>
                    <table class="table table-sm"><thead><tr><th>Rally</th><th>Year</th></tr></thead><tbody>
                    @foreach(var r in Model.Rallies) { <tr><td><a class="text-decoration-none" href="/RallyProfile?id=@r.rallyRowKey">@r.rallyName</a></td><td>@r.year</td></tr> }
                    </tbody></table>
                </div>
            </div>
        </div>
    </div>
</div>
