@page
@model App_FrontEnd.Pages.ClubProfile
@{
    ViewData["Title"] = "Club Profile";
}
<div class="card-modern p-4 mb-4">
    <h2>Club Profile</h2>
    <div class="text-center mb-3"><img src="@Model.LogoUrl" alt="Club logo" style="max-width:160px;max-height:160px;object-fit:contain;" /></div>
    <h3>@Model.ClubName</h3>
    <p class="text-muted">Overview of this club</p>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <p class="card-text"><strong>Website:</strong> <a href="@Model.Website">@Model.Website</a></p>
                </div>
                <p class="card-text"><strong>Rallies:</strong></p><ul>@foreach(var r in Model.Rallies){<li><a class="text-decoration-none" href="/RallyProfile?id=@r.rallyRowKey">@r.rallyName</a> (@r.year)</li>}</ul>
            </div>
        </div>
    </div>
</div>
