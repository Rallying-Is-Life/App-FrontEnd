<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable Microsoft.Identity.Web.UI source generator to avoid conflict with Razor Pages source generator -->
    <IncludeMicrosoftIdentityWebUISourceGenerator>false</IncludeMicrosoftIdentityWebUISourceGenerator>
    <MicrosoftIdentityWebUISourceGenerator>false</MicrosoftIdentityWebUISourceGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.18.0" />
  </ItemGroup>

</Project>
